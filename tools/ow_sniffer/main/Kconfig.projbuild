# SPDX-License-Identifier: MIT
menu "OW Sniffer"
    config OW_DATA_GPIO
        int "Passive DATA input GPIO (never driven)"
        range 0 14
        default 3
        help
            Choose a free, exposed GPIO. GPIO15 is reserved for the activity LED.
            Avoid USB, flash and boot strapping pins on your board.
    config OW_INTERNAL_PULLUP
        bool "Internal pull-up on DATA (diode level shifter to a 5 V bus)"
        default y
        help
            Wiring: STW-100 DATA (anode) -|>|- GPIO (cathode); best with an
            extra 4.7..10 kOhm resistor from GPIO to 3V3. Disable for a
            resistor divider, a direct 3.3 V bus or a BSS138 module.
    config OW_AP_PASSWORD
        string "SoftAP password (empty = open; otherwise 8 to 63 characters)"
        default ""
endmenu
