# GrainMeter - FireBeetle 2 ESP32-C6 (DFR1075), ESP-IDF v6.1.1
CONFIG_IDF_TARGET="esp32c6"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# OTA rollback: a new image boots as "pending verify" and must confirm itself
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# Service console and logs over the native USB Serial/JTAG
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_COMPILER_CXX_EXCEPTIONS=n
CONFIG_COMPILER_CXX_RTTI=n
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# TLS: verify ThingSpeak against the built-in CA bundle
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y
CONFIG_ESP_HTTP_CLIENT_ENABLE_HTTPS=y

# Captive portal requests from phones carry long headers
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
CONFIG_HTTPD_MAX_URI_LEN=512

# Post-mortem diagnostics in the coredump partition
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y

CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# Task list (name, free stack, priority) in /api/diag, like WIFI_RS.
CONFIG_FREERTOS_USE_TRACE_FACILITY=y

# Log lines with wall-clock time HH:MM:SS.sss (local time, GM_TIMEZONE)
# instead of milliseconds since boot.
CONFIG_LOG_TIMESTAMP_SOURCE_SYSTEM=y
