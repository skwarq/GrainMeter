{
  "name": "grainmeter-portal",
  "version": "0.1.0",
  "private": true,
  "description": "GrainMeter service portal (single-file web UI served by the device and the PC simulator)",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "build:dashboard": "node scripts/build-dashboard.mjs",
    "test": "node --test test/",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "npm run format:check && npm run lint && npm run test && npm run build && npm run build:dashboard",
    "fake-ota": "node scripts/fake-ota.mjs"
  },
  "dependencies": {
    "preact": "11.2.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "esbuild": "0.28.2",
    "eslint": "10.14.0",
    "globals": "17.14.0",
    "prettier": "3.9.10"
  }
}
